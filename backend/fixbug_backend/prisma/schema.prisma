// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TESTEUR
  CHEF_PROJET
  DEVELOPPEUR
  ADMINISTRATEUR
}

model Utilisateur {
  id         Int      @id @default(autoincrement())
  nom        String
  prenom     String
  email      String   @unique
  motdepasse String
  role       Role
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  projetsCrees   Projet[]              @relation("ProjetsCrees")
  collaborations ProjetCollaborateur[]
  invitations Invitation[]
  notifications Notification[]
  bugsDeclares Bug[]
  bugsPrisEnCharge Bug[] @relation("BugsPrisEnCharge")
  @@map("utilisateurs")
}

model Projet {
  id  Int    @id @default(autoincrement())
  nom String
  description String
  liengit String
  technologies String[]
  chefProjetId   Int
  chefProjet     Utilisateur           @relation("ProjetsCrees", fields: [chefProjetId], references: [id])
  collaborateurs ProjetCollaborateur[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  invitations Invitation[]
  bugs Bug[]
  @@map("projets")
}

model ProjetCollaborateur {
  id            Int         @id @default(autoincrement())
  projetId      Int
  projet        Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  dateAjout     DateTime    @default(now())
  @@unique([projetId, utilisateurId])
  @@map("projet_collaborateurs")
}

enum StatutInvitation {
  EN_ATTENTE
  ACCEPTEE
  REFUSEE
}
model Invitation {
  id Int @id @default(autoincrement())
  projetId Int 
  projet Projet @relation(fields: [projetId],references: [id],onDelete: Cascade)
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId],references: [id],onDelete: Cascade)
  statut StatutInvitation @default(EN_ATTENTE)
  dateEnvoie DateTime @default(now())
  @@map("invitations")
}

model Notification{
  id Int @id @default(autoincrement())
  utilisateurId Int
  utilisateur Utilisateur @relation(fields: [utilisateurId],references: [id],onDelete: Cascade)
  titre String
  contenu String
  lue Boolean @default(false)
  dateEnvoie DateTime @default(now())
  @@map("notifications")
} 

enum StatutBug {
  EN_COURS_DE_TRAITEMENT
  EN_ATTENTE_VALIDATION
  BLOQUE
  RESOLU
}

model Bug {
  id          Int       @id @default(autoincrement())
  titre       String?
  description String
  captures    String[]
  statut      StatutBug @default(EN_COURS_DE_TRAITEMENT)
  projetId    Int
  projet      Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  testeurId   Int
  testeur     Utilisateur @relation(fields: [testeurId], references: [id])
  developpeurId  Int?
  developpeur    Utilisateur? @relation("BugsPrisEnCharge", fields: [developpeurId], references: [id])
  proposition    String?
  numeroPR       Int?     
  urlPR          String?  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("bugs")
}