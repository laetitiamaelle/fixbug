// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TESTEUR
  CHEF_PROJET
  ADMINISTRATEUR
}

model Utilisateur {
  id         Int      @id @default(autoincrement())
  nom        String
  prenom     String
  email      String   @unique
  motdepasse String
  role       Role
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  projetsCrees   Projet[]              @relation("ProjetsCrees")
  collaborations ProjetCollaborateur[]

  @@map("utilisateurs")
}

model Projet {
  id  Int    @id @default(autoincrement())
  nom String
  description String
  liengit String
  technologie String[]
  chefProjetId   Int
  chefProjet     Utilisateur           @relation("ProjetsCrees", fields: [chefProjetId], references: [id])
  collaborateurs ProjetCollaborateur[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("projets")
}

model ProjetCollaborateur {
  id            Int         @id @default(autoincrement())
  projetId      Int
  projet        Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  dateAjout     DateTime    @default(now())

  @@unique([projetId, utilisateurId])
  @@map("projet_collaborateurs")
}
